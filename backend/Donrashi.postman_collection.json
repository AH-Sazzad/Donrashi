              "raw": "{\n  \"wallet_id\": 1,\n  \"category_id\": 1,\n  \"type\": \"expense\",\n  \"amount\": 25.50,\n  \"title\": \"Lunch at restaurant\",\n  \"note\": \"Team lunch meeting\",\n  \"transaction_date\": \"2026-10-01\"\n}"
